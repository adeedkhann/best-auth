{
  "name": "best-auth",
  "version": "0.0.1",
  "description": "The ultimate zero-config plug-and-play auth solution",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
 "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "keywords": ["auth", "nextjs", "authentication", "zero-config"],
  "author": "Adeed Khan",
  "license": "MIT"
}